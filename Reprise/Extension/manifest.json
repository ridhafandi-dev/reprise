{
  "manifest_version": 3,
  "name": "Reprise — Garder au bord",
  "version": "0.3.2",
  "description": "Une référence à portée de main, sans formulaire. Capture explicite et locale.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Garder au bord — Reprise",
    "default_icon": {
      "16": "icons/reprise-16.png",
      "32": "icons/reprise-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+R"
      },
      "description": "Garder cette page au bord"
    }
  },
  "icons": {
    "16": "icons/reprise-16.png",
    "32": "icons/reprise-32.png",
    "48": "icons/reprise-48.png",
    "128": "icons/reprise-128.png"
  }
}
